# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # set to "production" on Render

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/agritech
#
# Production (MongoDB Atlas — replace <username>, <password>, <cluster>, <dbname>):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRE=30d

# ── External APIs (optional) ──────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_CREATION_SECRET=replace_with_secure_admin_secret

# ── CORS (optional — comma-separated list of allowed origins) ─────────────────
# ALLOWED_ORIGINS=https://agritech-scs4.onrender.com,https://your-other-domain.com
